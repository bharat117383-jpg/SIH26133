# ==========================================
# Environment Variables — sih-healthcare-backend
# Copy this file's values into your own .env and NEVER commit real secrets.
# ==========================================

# Server
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=YOUR_PASSWORD
DB_NAME=sih_healthcare_db
DB_PORT=3306

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# CORS - comma separated list of allowed origins for your existing frontend
# Example: http://127.0.0.1:5500,http://localhost:5500
CORS_ORIGIN=*

# OpenRouter (server-side only — never expose to frontend)
OPENROUTER_API_KEY=PASTE_NEW_API_KEY_HERE
OPENROUTER_MODEL=openai/gpt-4o-mini
